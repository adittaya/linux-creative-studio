{
  "id": "raw-photo-development",
  "name": "RAW photo development",
  "keywords": [
    "raw",
    "dng",
    "develop",
    "demosaic",
    "lighttable"
  ],
  "description": "Develop camera RAW files non-destructively.",
  "required": [
    "darktable",
    "rawtherapee"
  ],
  "optional": [
    "digikam",
    "exiftool"
  ],
  "inputs": [
    "raw",
    "dng",
    "nef",
    "cr2",
    "arw"
  ],
  "outputs": [
    "tif",
    "jpg",
    "png",
    "xmp"
  ],
  "dependencies": [
    "color-management",
    "exiftool"
  ],
  "presets": [
    "presets/color"
  ],
  "templates": [
    "templates/general"
  ],
  "workflow": "Ingest -> catalog -> apply scene-referred defaults -> refine tone/color -> export TIFF -> archive XMP sidecars.",
  "validation": "Check EXIF integrity, bit depth and embedded ICC profile on export."
}
