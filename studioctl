#!/usr/bin/env python3
"""studioctl - AI-accessible control plane for the Linux Creative Studio.

Design rules:
  * Python standard library only; no network access from this tool.
  * Application IDs come from registry/applications.json only.
  * Launches use allowlisted, resolved executable paths and argv arrays (never shell=True).
  * Every JSON output shape is stable and intended for programmatic consumption.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
REGISTRY = ROOT / "registry"
ALLOWED_SUFFIXES = {".sh", ".bash", ".py"}
LAUNCH_TIMEOUT = 45

# Canonical binary names allowed for PATH resolution. Only names derived from
# a manifest's executable basename or listed here may ever be executed.
BINARY_ALIASES = {
    "imagemagick": ["magick"],
    "nodejs": ["node"],
    "python": ["python3"],
    "archives": ["7z", "7za"],
    "davinci-resolve": ["resolve"],
    "gmic": ["gmic"],
    "glaxnimate": ["glaxnimate"],
    "shutter-encoder": ["shutter-encoder"],
    "lottie": ["lottie-tools"],
    "svg-tools": ["svg-tools"],
    "vfx-utilities": [],
    "luts": [],
    "aces": [],
    "audio-plugins": [],
}

VERSION_FLAGS = {
    "ffmpeg": ["-version"], "ffprobe": ["-version"],
    "libvips": ["--version"], "imagemagick": ["--version"],
}


CLI_TOOLS = {
    "ffmpeg", "ffprobe", "imagemagick", "exiftool", "libvips", "gmic", "assimp",
    "git", "jq", "archives", "python", "nodejs", "typescript", "opencolorio",
    "argyllcms", "gstreamer", "mediainfo", "mkvtoolnix", "ace-config", "aces",
    "vid-utilities", "vfx-utilities", "open-image-denoise", "luxcorerender",
}

STOPWORDS = {"a", "an", "the", "create", "make", "with", "for", "to", "of", "and",
             "image", "edit", "editing", "generate", "using", "into", "some",
             "need", "want", "please", "project", "workflow"}

# Term expansion keeps natural-language tasks aligned with capability names.
SYNONYMS = {
    "animated": ["animation", "animate"], "animating": ["animation"], "animate": ["animation"],
    "product": ["product-rendering"], "render": ["rendering"], "rendered": ["rendering"],
    "grade": ["color-grading", "grading"], "graded": ["color-grading", "grading"],
    "colour": ["color"], "photo": ["photo-editing"], "photograph": ["photo-editing"],
    "photographic": ["photo-editing"], "background": ["background-removal"],
    "remove": ["background-removal"], "removal": ["background-removal"],
    "parallax": ["2.5d-animation"], "cinematic": ["2.5d-animation", "camera-movement"],
    "marketing": ["programmatic-video", "batch-video-generation"],
    "personalized": ["programmatic-video", "batch-video-generation"],
    "personalised": ["programmatic-video", "batch-video-generation"],
    "hundreds": ["batch-video-generation"], "thousands": ["batch-video-generation"],
    "titles": ["motion-graphics"], "title": ["motion-graphics"],
    "sound": ["audio-production"], "music": ["music-production"],
    "3d": ["3d-modeling", "3d-rendering"], "2d": ["2d-animation"],
    "draw": ["digital-painting", "2d-animation"], "drawing": ["digital-painting"],
    "character": ["rigging", "2d-animation"], "cutout": ["cutout-animation"],
    "composite": ["compositing"], "vfx": ["compositing"],
    "footage": ["video-editing"], "cut": ["video-editing"], "trim": ["video-trimming"],
    "mix": ["audio-mixing"], "record": ["audio-recording"],
    "headless": ["programmatic-video", "automation"], "batch": ["batch-processing"],
    "looks": ["lut-processing", "color-grading"], "4k": ["color-grading", "video-editing"],
}


def load_json(path: Path):
    with path.open(encoding="utf-8") as f:
        return json.load(f)


def registry() -> dict:
    return load_json(REGISTRY / "applications.json")


def profiles() -> list:
    return load_json(REGISTRY / "task-profiles.json")["profiles"]


def apps_by_id() -> dict:
    return {a["id"]: a for a in registry()["applications"]}


def emit(data, as_json: bool, human_fn=None) -> int:
    if as_json:
        print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=False))
    elif human_fn:
        human_fn()
    else:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    return 0


def out(data):
    print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=False))


def fail(msg: str, code: int = 2, as_json: bool = False) -> int:
    if as_json:
        out({"ok": False, "error": msg, "exit_code": code})
    else:
        print(f"studioctl: {msg}", file=sys.stderr)
    return code


def tokens(text: str) -> set[str]:
    text = (text or "").lower().replace("_", " ").replace("-", " ")
    words = set(re.findall(r"[a-z0-9][a-z0-9.]*", text))
    return words - STOPWORDS


def expand_tokens(base: set[str]) -> set[str]:
    result = set(base)
    for word in base:
        for synonym in SYNONYMS.get(word, []):
            result.add(synonym)
            result |= tokens(synonym)
    return result


COMMON_TERMS = {"video", "animation", "color", "rendering", "3d", "2d", "modeling",
                "processing", "generation", "image", "editing", "design"}


def term_weight(token: str) -> int:
    if token in COMMON_TERMS:
        return 1
    return 3 if len(token) > 2 else 1


def candidate_names(app: dict) -> list[str]:
    names = []
    base = Path(app.get("executable", "")).name
    if base:
        names.append(base)
    names.extend(BINARY_ALIASES.get(app["id"], []))
    seen, result = set(), []
    for n in names:
        if n not in seen:
            seen.add(n)
            result.append(n)
    return result


def resolve_candidates(app: dict) -> list[dict]:
    """Return allowlisted executable candidates with presence information."""
    by_id = apps_by_id()
    if app.get("facade_of"):
        parent = by_id.get(app["facade_of"])
        return resolve_candidates(parent) if parent else []

    results = []
    declared = app.get("executable", "")
    if declared and not declared.startswith("http"):
        p = (ROOT / declared).resolve()
        results.append({"path": str(p), "kind": "manifest-relative", "present": p.is_file() and os.access(p, os.X_OK)})
        # Also record a conventional active/ path even if declared points elsewhere.
        if "/active/" not in declared:
            pkg = ROOT / app.get("package_path", "")
            for name in candidate_names(app):
                q = (pkg / "active" / "bin" / name).resolve()
                if str(q) not in [r["path"] for r in results]:
                    results.append({"path": str(q), "kind": "package-active", "present": q.is_file() and os.access(q, os.X_OK)})

    for name in candidate_names(app):
        found = shutil.which(name)
        if found:
            p = Path(found).resolve()
            if p.is_file() and os.access(p, os.X_OK) and str(p) not in [r["path"] for r in results]:
                results.append({"path": str(p), "kind": "system-PATH", "present": True})

    # Allowlist guard: reject anything outside the studio root or an absolute
    # system bin directory, and reject world-writable locations.
    safe = []
    for r in results:
        p = Path(r["path"])
        parent_ok = str(p).startswith(str(ROOT) + os.sep) or any(
            str(p).startswith(prefix) for prefix in ("/usr/bin/", "/usr/local/bin/", "/bin/", "/opt/")
        )
        if parent_ok and not (p.parent.stat().st_mode & 0o002 if p.parent.exists() else True):
            safe.append(r)
    return safe


def first_installed(app: dict) -> dict | None:
    for c in resolve_candidates(app):
        if c["present"]:
            return c
    return None


def install_record(app: dict) -> dict:
    found = first_installed(app)
    return {
        "id": app["id"],
        "facade_of": app.get("facade_of"),
        "installed": bool(found),
        "executable": found["path"] if found else None,
        "candidates": resolve_candidates(app),
        "installation_methods": app.get("installation_methods", []),
        "artifact_status": app.get("artifact_status", "unknown"),
        "verification_status": app.get("verification_status", "unknown"),
    }


def score_app(app: dict, q_tokens: set[str], query: str, profile_hits: dict) -> tuple[int, list[str]]:
    reasons: list[str] = []
    score = 0
    norm_query = query.lower().replace("_", " ")
    for cap in app.get("capabilities", []):
        cap_terms = tokens(cap)
        cap_norm = cap.replace("-", " ")
        overlap = q_tokens & cap_terms
        if cap in q_tokens:
            score += 18
            reasons.append(f"exact capability match: {cap}")
        elif cap_norm and cap_norm in norm_query:
            score += 12
            reasons.append(f"direct capability match: {cap}")
        elif overlap:
            score += sum(term_weight(t) for t in overlap)
            reasons.append(f"related capability: {cap} ({', '.join(sorted(overlap))})")
    name = tokens(app.get("name", ""))
    name_overlap = q_tokens & name
    if name_overlap:
        score += 2 * sum(term_weight(t) for t in name_overlap)
        reasons.append(f"name match: {', '.join(sorted(name_overlap))}")
    desc_overlap = q_tokens & tokens(app.get("description", ""))
    if desc_overlap:
        score += sum(term_weight(t) for t in desc_overlap)
        reasons.append(f"description terms: {', '.join(sorted(desc_overlap))}")
    for p in profile_hits:
        if app["id"] in p["profile"].get("required", []):
            score += 16 + 4 * p["score"]
            reasons.append(f"required by profile '{p['profile']['name']}'")
        elif app["id"] in p["profile"].get("optional", []):
            score += 4
            reasons.append(f"optional in profile '{p['profile']['name']}'")
    return score, reasons


def profile_matches(query: str) -> list[dict]:
    q = expand_tokens(tokens(query))
    hits = []
    for p in profiles():
        pt = tokens(p["name"] + " " + " ".join(p.get("keywords", [])))
        overlap = q & pt
        if overlap:
            hits.append({"profile": p, "overlap": sorted(overlap), "score": len(overlap)})
    hits.sort(key=lambda x: (-x["score"], x["profile"]["id"]))
    return hits[:4]


def search_impl(query: str) -> dict:
    q = expand_tokens(tokens(query))
    hits = profile_matches(query)
    ranked = []
    for app in registry()["applications"]:
        score, reasons = score_app(app, q, query, hits)
        if score > 0:
            ranked.append({
                "id": app["id"], "name": app["name"], "category": app["category"],
                "score": score, "reasons": reasons[:8],
                "capabilities": app["capabilities"][:10],
                "installed": bool(first_installed(app)),
                "verification_status": app["verification_status"],
                "launch_command": f"studioctl launch {app['id']}",
            })
    ranked.sort(key=lambda x: (-x["score"], x["id"]))
    return {
        "ok": True, "query": query, "query_tokens": sorted(q),
        "matched_profiles": [{"id": h["profile"]["id"], "name": h["profile"]["name"],
                              "overlap": h["overlap"]} for h in hits],
        "results": ranked, "count": len(ranked),
    }


def plan_impl(task: str, limit: int) -> dict:
    hits = profile_matches(task)
    search = search_impl(task)
    selected = search["results"][:limit]
    toolchain = []
    for item in selected:
        app = apps_by_id()[item["id"]]
        found = first_installed(app)
        dep_apps = []
        for dep in app.get("runtime_dependencies", []):
            dep_apps.append({"name": dep, "recorded": True,
                             "resolvable_binary": bool(shutil.which(dep))})
        role = "core"
        for h in hits:
            if app["id"] in h["profile"].get("required", []):
                role = f"required by '{h['profile']['name']}'"
                break
            if app["id"] in h["profile"].get("optional", []):
                role = f"optional for '{h['profile']['name']}'"
                break
        toolchain.append({
            "id": app["id"], "name": app["name"], "category": app["category"],
            "role": role, "score": item["score"], "why": item["reasons"],
            "capabilities": app["capabilities"],
            "input_formats": app.get("supported_formats", []),
            "dependencies": {"recorded": app.get("runtime_dependencies", []),
                             "resolvable_binaries": dep_apps},
            "installed": bool(found),
            "executable": found["path"] if found else None,
            "verification_status": app["verification_status"],
            "offline_available": app["offline_available"],
            "launch_command": f"studioctl launch {app['id']}",
        })
    installed_ids = {t["id"] for t in toolchain if t["installed"]}
    workflow = []
    for h in hits:
        workflow.append({"profile": h["profile"]["id"],
                         "description": h["profile"]["description"],
                         "steps": h["profile"]["workflow"],
                         "validation": h["profile"]["validation"]})
    notes = []
    for t in toolchain:
        app = apps_by_id()[t["id"]]
        if app.get("note"):
            notes.append(f"{t['name']}: {app['note']}")
        if not t["installed"]:
            notes.append(f"{t['name']}: not installed on this host; install method(s): {', '.join(app['installation_methods']) or 'n/a'}")
    return {
        "ok": True, "task": task,
        "matched_profiles": [h["profile"]["id"] for h in hits],
        "proposed_toolchain": toolchain,
        "workflows": workflow,
        "verification": {
            "selected_count": len(toolchain),
            "installed_count": len(installed_ids),
            "missing_ids": [t["id"] for t in toolchain if not t["installed"]],
            "all_selected_installed": len(installed_ids) == len(toolchain),
        },
        "notes": notes,
        "disclaimer": "Tool selection is advisory. No application is assumed verified; check verification_status and run studioctl doctor.",
    }


def cmd_list(args) -> int:
    data = registry()["applications"]
    if args.category:
        data = [a for a in data if a["category"] == args.category]
    if args.status:
        data = [a for a in data if a["verification_status"] == args.status]
    if args.installed:
        data = [a for a in data if first_installed(a)]
    rows = [{
        "id": a["id"], "name": a["name"], "category": a["category"],
        "verification_status": a["verification_status"],
        "installed": bool(first_installed(a)),
        "offline_available": a["offline_available"],
    } for a in data]
    if args.json:
        return emit({"ok": True, "count": len(rows), "applications": rows}, True)
    print(f"{'ID':<26} {'CATEGORY':<22} {'INSTALLED':<10} {'STATUS':<22} NAME")
    for r in rows:
        print(f"{r['id']:<26} {r['category']:<22} {str(r['installed']):<10} {r['verification_status']:<22} {r['name']}")
    print(f"\n{len(rows)} application(s)")
    return 0


def cmd_search(args) -> int:
    data = search_impl(args.query)
    if args.json or not data["results"]:
        return emit(data, True)
    print(f"Query: {args.query}  |  matches: {data['count']}")
    for r in data["results"][: args.limit]:
        print(f"\n[{r['score']:>3}] {r['name']} ({r['id']}) — {r['category']}"
              f"{' [installed]' if r['installed'] else ''}")
        print(f"      {'; '.join(r['reasons'][:4])}")
    print("\nUse --json for full machine-readable results.")
    return 0


def cmd_info(args) -> int:
    by_id = apps_by_id()
    if args.id not in by_id:
        return fail(f"unknown application id '{args.id}'; use `studioctl list --json`", 3, args.json)
    app = by_id[args.id]
    data = dict(app)
    data.update(install_record(app))
    data["candidate_paths"] = data.pop("candidates")
    if args.json:
        return emit({"ok": True, "application": data}, True)
    print(f"{data['name']} [{data['id']}] — {data['category']}\n")
    print(data["description"] + "\n")
    for key in ["researched_version", "verification_status", "installed", "executable",
                "license_type", "offline_available", "requires_network_for_installation",
                "requires_online_activation", "hardware_requirements", "facade_of",
                "launch_command", "verification_command", "documentation"]:
        print(f"{key:<38}: {data.get(key)}")
    print(f"{'capabilities':<38}: {', '.join(data['capabilities'])}")
    print(f"{'supported_formats':<38}: {', '.join(data['supported_formats'])}")
    print(f"{'runtime_dependencies':<38}: {', '.join(data['runtime_dependencies']) or 'none'}")
    print(f"{'installation_methods':<38}: {', '.join(data['installation_methods']) or 'n/a'}")
    if data.get("notes"):
        print(f"\nNote: {data['notes']}")
    return 0


def cmd_capabilities(args) -> int:
    data = load_json(REGISTRY / "capabilities.json")
    if args.json:
        return emit(data, True)
    print(f"{len(data['capabilities'])} capabilities indexed\n")
    for cap in sorted(data["capabilities"]):
        apps = data["capabilities"][cap]
        print(f"{cap:<36} {len(apps):>2}  {', '.join(apps[:6])}")
    return 0


def cmd_plan(args) -> int:
    data = plan_impl(args.task, args.limit)
    if args.json:
        return emit(data, True)
    print(f"Task: {args.task}\n")
    print("Proposed toolchain:")
    for t in data["proposed_toolchain"]:
        flag = "OK" if t["installed"] else "NOT INSTALLED"
        print(f"  - {t['name']:<26} [{flag:<12}] score={t['score']:<3} role={t['role']}")
        print(f"      why: {'; '.join(t['why'][:4])}")
    for w in data["workflows"]:
        print(f"\nWorkflow ({w['profile']}):\n  {w['steps']}\n  Validate: {w['validation']}")
    v = data["verification"]
    print(f"\nVerification: {v['installed_count']}/{v['selected_count']} selected tools installed")
    if v["missing_ids"]:
        print(f"Missing: {', '.join(v['missing_ids'])}")
    for n in data["notes"][:8]:
        print(f"Note: {n}")
    return 0


def safe_input_arg(app: dict, value: str | None) -> list[str]:
    if not value:
        return []
    p = Path(value).expanduser().resolve()
    if not p.is_file():
        raise ValueError(f"input path does not exist: {p}")
    ext = p.suffix.lower().lstrip(".")
    allowed = {f.lower().lstrip(".") for f in app.get("supported_formats", [])}
    if ext and allowed and ext not in allowed:
        raise ValueError(f"input extension '.{ext}' is not in this application's supported_formats")
    return [str(p)]


def cmd_launch(args) -> int:
    by_id = apps_by_id()
    if args.id not in by_id:
        return fail(f"unknown application id '{args.id}'", 3, args.json)
    app = by_id[args.id]
    parent_note = None
    if app.get("facade_of"):
        parent_note = f"{app['name']} is a capability facet of {app['facade_of']}; launching the parent application"
        app = by_id[app["facade_of"]]
    found = first_installed(app)
    plan = {
        "ok": True, "requested_id": args.id, "resolved_id": app["id"],
        "dry_run": args.dry_run, "facade_note": parent_note,
        "installed": bool(found), "executable": found["path"] if found else None,
        "argv": [], "log": None,
    }
    if not found:
        plan["ok"] = False
        plan["error"] = "application is not installed on this host"
        plan["installation_methods"] = app["installation_methods"]
        plan["hint"] = "Run scripts/install.sh --package <id> after acquiring a verified artifact."
        return emit(plan, True if (args.json or args.dry_run) else False,
                    lambda: print(f"studioctl: {app['name']} is not installed.\n"
                                  f"  install methods: {', '.join(app['installation_methods']) or 'n/a'}\n"
                                  f"  prepare artifacts: scripts/download-packages.sh\n"
                                  f"  inspect: studioctl info {args.id}"))
    try:
        extra = safe_input_arg(app, args.input)
    except ValueError as exc:
        return fail(str(exc), 4, args.json)
    plan["argv"] = [found["path"]] + extra
    if args.dry_run:
        plan["would_launch"] = True
        return emit(plan, True)
    is_cli = app["id"] in CLI_TOOLS
    log_dir = ROOT / "logs"
    log_dir.mkdir(exist_ok=True)
    log = log_dir / f"launch-{args.id}.log"
    try:
        if is_cli:
            with log.open("a", encoding="utf-8") as lf:
                lf.write(f"\n$ {' '.join(plan['argv'])}\n")
                proc = subprocess.run(plan["argv"], stdout=lf, stderr=subprocess.STDOUT,
                                      timeout=LAUNCH_TIMEOUT, check=False, shell=False)
            plan["returncode"] = proc.returncode
            plan["output_note"] = f"CLI output written to {log.relative_to(ROOT)}"
        else:
            with log.open("ab") as lf:
                proc = subprocess.Popen(plan["argv"], stdout=lf, stderr=subprocess.STDOUT,
                                        cwd=ROOT / "workspaces" / "temporary",
                                        start_new_session=True, shell=False)
            plan["pid"] = proc.pid
            plan["output_note"] = f"GUI process started; log: {log.relative_to(ROOT)}"
        plan["log"] = str(log.relative_to(ROOT))
    except Exception as exc:  # noqa: BLE001 - report, never crash silently
        plan["ok"] = False
        plan["error"] = f"{type(exc).__name__}: {exc}"
        return emit(plan, True)
    return emit(plan, True if args.json else False,
                lambda: print(f"Launched {app['name']} ({app['id']}): {plan.get('output_note')}"))


def cmd_verify(args) -> int:
    by_id = apps_by_id()
    if args.id:
        if args.id not in by_id:
            return fail(f"unknown application id '{args.id}'", 3, args.json)
        targets = [by_id[args.id]]
    else:
        targets = registry()["applications"]
    results = []
    for app in targets:
        pkg = ROOT / app.get("package_path", "")
        found = first_installed(app)
        missing = []
        for f in ["metadata/application.json", "metadata/capabilities.json",
                  "metadata/dependencies.json", "metadata/compatibility.json",
                  "metadata/sources.json", "metadata/license.json", "README.md",
                  "scripts/install.sh", "scripts/launch.sh", "scripts/verify.sh"]:
            if not (pkg / f).is_file():
                missing.append(f)
        record = {
            "id": app["id"], "name": app["name"], "manifest_present": (pkg / "metadata/application.json").is_file(),
            "missing_files": missing, "executable_present": bool(found),
            "executable": found["path"] if found else None,
            "declared_verification_status": app["verification_status"],
            "artifact_status": app.get("artifact_status"),
        }
        if args.smoke and found and app["id"] in CLI_TOOLS:
            try:
                proc = subprocess.run([found["path"]] + VERSION_FLAGS.get(app["id"], ["--version"]), capture_output=True,
                                      text=True, timeout=15, check=False, shell=False)
                version = (proc.stdout or proc.stderr).strip().splitlines()
                record["smoke_test"] = {"attempted": True, "returncode": proc.returncode,
                                        "first_line": version[0] if version else ""}
            except Exception as exc:  # noqa: BLE001
                record["smoke_test"] = {"attempted": True, "error": str(exc)}
        else:
            record["smoke_test"] = {"attempted": False}
        record["verdict"] = (
            "structure-incomplete" if missing else
            "not-installed" if not found else
            "installed-unverified" if not args.smoke else
            "smoke-passed" if record["smoke_test"].get("returncode") == 0 else
            "smoke-failed"
        )
        results.append(record)
    passed = sum(1 for r in results if r["verdict"] in ("smoke-passed", "installed-unverified"))
    data = {"ok": True, "smoke": args.smoke, "checked": len(results), "passed": passed,
            "results": results,
            "disclaimer": "Structural verification is NOT application validation. Run tests/ on target hardware."}
    if args.json:
        return emit(data, True)
    for r in results:
        print(f"{r['id']:<26} {r['verdict']:<24} {r.get('executable') or '-'}")
    print(f"\n{passed}/{len(results)} have manifests and an available executable.")
    return 0


def cmd_doctor(args) -> int:
    problems = []
    warnings = []
    apps = registry()["applications"]
    required_paths = ["studioctl", "registry/applications.json", "registry/capabilities.json",
                      "registry/dependencies.json", "registry/compatibility.json",
                      "registry/task-profiles.json", "scripts/detect-system.sh",
                      "scripts/detect-hardware.sh", "scripts/install.sh", "scripts/verify.sh"]
    for p in required_paths:
        if not (ROOT / p).exists():
            problems.append(f"missing required path: {p}")
    ids = [a["id"] for a in apps]
    if len(ids) != len(set(ids)):
        problems.append("duplicate application IDs in registry")
    for a in apps:
        for f in ["metadata/application.json", "metadata/capabilities.json", "metadata/dependencies.json",
                  "metadata/compatibility.json", "metadata/sources.json", "metadata/license.json"]:
            p = ROOT / a.get("package_path", "") / f
            if not p.is_file():
                problems.append(f"{a['id']}: missing {f}")
        if a["id"] != a.get("manifest", {}).get("id", a["id"]):
            problems.append(f"{a['id']}: manifest id mismatch")
        if not (ROOT / "docs/applications" / f"{a['id']}.md").is_file():
            warnings.append(f"{a['id']}: missing application doc page")
        if a.get("verification_status") in ("verified", "offline-verified"):
            problems.append(f"{a['id']}: claimed verified status without test log")
    for name in ["README.md", "INSTALL.md", "OFFLINE_GUIDE.md", "AI_AGENT_GUIDE.md",
                 "COMPATIBILITY.md", "SECURITY.md", "LICENSES.md", "CHANGELOG.md", "TROUBLESHOOTING.md"]:
        if not (ROOT / name).is_file():
            warnings.append(f"missing root document: {name}")
    du = shutil.disk_usage(ROOT)
    data = {
        "ok": len(problems) == 0,
        "studio_root": str(ROOT),
        "python": {"version": sys.version.split()[0], "ok": sys.version_info >= (3, 9)},
        "host": {"system": os.uname().sysname, "release": os.uname().release, "machine": os.uname().machine},
        "registry": {"applications": len(apps), "profiles": len(profiles()),
                     "capabilities": load_json(REGISTRY / "capabilities.json")["capability_count"],
                     "artifact_count": load_json(REGISTRY / "package-index.json").get("artifact_count", 0)},
        "disk": {"total_gb": round(du.total / 1e9, 2), "free_gb": round(du.free / 1e9, 2)},
        "installed_applications": sum(1 for a in apps if first_installed(a)),
        "problems": problems, "warnings": warnings,
        "honest_state": "foundation scaffold: no artifacts downloaded and no application tests executed",
    }
    if args.json:
        return emit(data, True)
    print(f"studioctl doctor — {data['studio_root']}")
    for k, v in data["registry"].items():
        print(f"  registry.{k:<16}: {v}")
    print(f"  installed applications : {data['installed_applications']}")
    print(f"  free disk              : {data['disk']['free_gb']} GB")
    print(f"\nproblems: {len(problems)}  warnings: {len(warnings)}")
    for p in problems:
        print(f"  ERROR: {p}")
    for p in warnings[:10]:
        print(f"  WARN:  {p}")
    return 0 if not problems else 1


def cmd_offline_check(args) -> int:
    apps = registry()["applications"]
    repo = ROOT / "offline-repo"
    artifact_dirs = [repo / d for d in ["appimages", "deb-packages", "portable-archives",
                                        "python-wheels", "npm-cache", "source-archives", "apt"]]
    rows = []
    for a in apps:
        found = first_installed(a)
        artifacts = []
        for d in artifact_dirs:
            if d.is_dir():
                artifacts.extend(str(p.relative_to(ROOT)) for p in d.rglob("*")
                                 if p.is_file() and a["id"].replace("-", "") in p.name.lower().replace("-", "").replace("_", ""))
        offline = a["offline_available"]
        ready = offline or bool(found) or bool(artifacts)
        restricted = (a.get("verification_status") == "not-redistributable"
                      or "restricted" in a.get("license_type", "").lower()
                      or a.get("verification_status") == "unavailable")
        rows.append({
            "id": a["id"], "offline_capable": offline,
            "requires_network_for_installation": a["requires_network_for_installation"],
            "requires_online_activation": a["requires_online_activation"],
            "installed_locally": bool(found), "cached_artifacts": artifacts[:5],
            "verdict": "restricted" if restricted else
                       "facade" if a.get("facade_of") else
                       "available-locally" if ready else
                       "artifact-not-cached",
        })
    summary = {}
    for r in rows:
        summary[r["verdict"]] = summary.get(r["verdict"], 0) + 1
    data = {"ok": True, "network_used": False, "summary": summary, "applications": rows,
            "disclaimer": "This checks cached state only. True offline verification requires isolated-host render tests."}
    if args.json:
        return emit(data, True)
    for v, n in sorted(summary.items()):
        print(f"{v:<22}: {n}")
    print("\nUse --json for per-application detail.")
    return 0


def cmd_status(args) -> int:
    apps = registry()["applications"]
    by_status, by_cat = {}, {}
    for a in apps:
        by_status[a["verification_status"]] = by_status.get(a["verification_status"], 0) + 1
        by_cat[a["category"]] = by_cat.get(a["category"], 0) + 1
    data = {
        "ok": True, "studio_root": str(ROOT),
        "total_applications": len(apps),
        "installed_on_this_host": sum(1 for a in apps if first_installed(a)),
        "artifacts_cached": load_json(REGISTRY / "package-index.json").get("artifact_count", 0),
        "by_verification_status": by_status, "by_category": by_cat,
        "offline_bundle_ready": False,
        "notes": "Foundation scaffold. No downloads, installs or functional tests performed.",
    }
    return emit(data, True if args.json else False,
                lambda: (print(f"Linux Creative Studio — {data['total_applications']} applications, "
                               f"{data['installed_on_this_host']} installed here, "
                               f"{data['artifacts_cached']} cached artifacts"),
                         print("\nBy status:"), [print(f"  {k:<24} {v}") for k, v in sorted(by_status.items())],
                         print("\nBy category:"), [print(f"  {k:<24} {v}") for k, v in sorted(by_cat.items())]))


def cmd_deps(args) -> int:
    by_id = apps_by_id()
    if args.id not in by_id:
        return fail(f"unknown application id '{args.id}'", 3, args.json)
    app = by_id[args.id]
    deps = []
    for d in app["runtime_dependencies"]:
        deps.append({"dependency": d, "binary_on_PATH": bool(shutil.which(d)),
                     "recommended_source": "record-only; use distribution packages or cached artifacts"})
    data = {"ok": True, "id": app["id"], "dependencies": deps,
            "policy": "Never replace system glibc, Python or graphics drivers to satisfy a dependency."}
    if args.json:
        return emit(data, True)
    print(f"Dependencies for {app['name']}:")
    for d in deps:
        print(f"  {d['dependency']:<28} PATH: {d['binary_on_PATH']}")
    return 0


def cmd_profiles(args) -> int:
    data = profiles()
    if args.id:
        match = next((p for p in data if p["id"] == args.id), None)
        if not match:
            return fail(f"unknown profile '{args.id}'", 3, args.json)
        if args.json:
            return emit({"ok": True, "profile": match}, True)
        print(json.dumps(match, indent=2, ensure_ascii=False))
        return 0
    rows = [{"id": p["id"], "name": p["name"], "required": p["required"],
             "optional_count": len(p["optional"])} for p in data]
    if args.json:
        return emit({"ok": True, "count": len(rows), "profiles": rows}, True)
    for p in rows:
        print(f"{p['id']:<28} {p['name']:<42} required: {', '.join(p['required'])}")
    return 0


def cmd_detect(args) -> int:
    script = ROOT / "scripts" / ("detect-hardware.sh" if args.hardware else "detect-system.sh")
    if not script.is_file():
        return fail(f"missing {script}", 3, args.json)
    proc = subprocess.run(["bash", str(script)], capture_output=True, text=True, check=False, shell=False)
    if proc.returncode != 0:
        return fail(proc.stderr.strip() or "detection script failed", 4, args.json)
    try:
        data = json.loads(proc.stdout)
        return emit({"ok": True, **data}, args.json or True)
    except json.JSONDecodeError:
        return emit({"ok": True, "raw": proc.stdout.strip()}, args.json or True)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="studioctl", description="Offline Linux Creative Studio control CLI")
    p.add_argument("--version", action="version", version="studioctl 1.0.0 (foundation scaffold)")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("list", help="list applications")
    sp.add_argument("--category")
    sp.add_argument("--status")
    sp.add_argument("--installed", action="store_true")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_list)

    sp = sub.add_parser("search", help="search by natural-language capability")
    sp.add_argument("query")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--limit", type=int, default=12)
    sp.set_defaults(fn=cmd_search)

    sp = sub.add_parser("info", help="application manifest and install state")
    sp.add_argument("id")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_info)

    sp = sub.add_parser("capabilities", help="capability index")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_capabilities)

    sp = sub.add_parser("plan", help="task-to-toolchain planner")
    sp.add_argument("--task", required=True)
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--limit", type=int, default=6)
    sp.set_defaults(fn=cmd_plan)

    sp = sub.add_parser("launch", help="launch an allowlisted application")
    sp.add_argument("id")
    sp.add_argument("--input", help="existing input file with an allowed extension")
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_launch)

    sp = sub.add_parser("verify", help="verify manifests and executables")
    sp.add_argument("--id")
    sp.add_argument("--smoke", action="store_true", help="also run <exe> --version for CLI tools")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_verify)

    sp = sub.add_parser("doctor", help="diagnose the studio")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_doctor)

    sp = sub.add_parser("offline-check", help="report cached/offline state without network")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_offline_check)

    sp = sub.add_parser("status", help="summary status")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_status)

    sp = sub.add_parser("deps", help="inspect recorded dependencies")
    sp.add_argument("id")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_deps)

    sp = sub.add_parser("profiles", help="list or show task profiles")
    sp.add_argument("id", nargs="?")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_profiles)

    sp = sub.add_parser("detect", help="run system/hardware detection")
    sp.add_argument("--hardware", action="store_true")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_detect)

    return p


def main() -> int:
    args = build_parser().parse_args()
    try:
        return int(args.fn(args) or 0)
    except (OSError, json.JSONDecodeError, KeyError) as exc:
        return fail(f"{type(exc).__name__}: {exc}", 1, getattr(args, "json", False))


if __name__ == "__main__":
    sys.exit(main())
